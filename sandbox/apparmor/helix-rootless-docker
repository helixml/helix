#include <tunables/global>

# Moby profiles/apparmor v0.1.0, Apache-2.0. The default deny mount rule is
# replaced with mount and pivot_root permissions for nested rootless Docker.
# Namespaced network sysctls stay writable. Detached procfs network sysctls
# appear below /sys/net with runc 1.3.x.
profile helix-rootless-docker flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  mount,
  pivot_root,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=helix-rootless-docker,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^kn]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny @{PROC}/{asound,acpi,scsi}{,/**} rwklx,
  deny @{PROC}/{keys,latency_stats,timer_list,timer_stats,sched_debug} rwklx,

  deny /sys/[^fn]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware{,/**} rwklx,
  deny /sys/devices/virtual/powercap{,/**} rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=helix-rootless-docker,
}
