# Crawler browser: go-rod's launcher manager (rod-manager) in front of a
# current Chromium. Same contract as ghcr.io/go-rod/rod: the manager listens
# on :7317 and the API connects with launcher.NewManaged
# (RAG_CRAWLER_LAUNCHER_URL). rod-manager is built from the go-rod version in
# go.mod, so the manager and the API's launcher client always match.
#
#   docker build -f Dockerfile.chrome -t helix-chrome .
#
# Chromium comes from Debian trixie (chromium-headless-shell), which Debian
# security tracks on the current stable major; a rebuild picks up the latest.
# The build fails below the floor in chrome-version.env, and CI runs
# scripts/check-chromium-freshness.sh against the result.

FROM golang:1.27 AS manager
WORKDIR /src
COPY go.mod go.sum ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" \
      -o /out/rod-manager github.com/go-rod/rod/lib/launcher/rod-manager

FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      chromium-headless-shell \
      ca-certificates \
      dumb-init \
      fonts-liberation \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      tzdata \
 && rm -rf /var/lib/apt/lists/*

COPY chrome-version.env /etc/helix/chrome-version.env
RUN . /etc/helix/chrome-version.env \
 && major=$(/usr/lib/chromium/chromium-headless-shell --version | sed -E 's/^[^0-9]*([0-9]+)\..*/\1/') \
 && echo "Chromium major ${major} (floor ${CHROMIUM_MIN_MAJOR})" \
 && [ "${major}" -ge "${CHROMIUM_MIN_MAJOR}" ]

COPY --from=manager /out/rod-manager /usr/local/bin/rod-manager

# rod-manager only launches browser binaries under $HOME/.cache/rod/browser.
# The link is root-owned so the manager cannot replace it or fall back to
# downloading go-rod's bundled Chromium.
RUN useradd --system --uid 10001 --create-home --home-dir /home/rod rod \
 && mkdir -p /home/rod/.cache/rod/browser/chromium \
 && ln -s /usr/lib/chromium/chromium-headless-shell /home/rod/.cache/rod/browser/chromium/chrome \
 && chown -R root:root /home/rod/.cache \
 && touch /.dockerenv

ENV HOME=/home/rod
USER 10001
WORKDIR /home/rod
EXPOSE 7317

ENTRYPOINT ["dumb-init", "--"]
CMD ["rod-manager", "-rod", "bin=/home/rod/.cache/rod/browser/chromium/chrome"]
