#!/bin/sh
# DeepSeek Harness ACP server, spawned by Zed as the `dsh` agent_server:
# upstream's shipped `acp` profile with the Helix patch layered on top.
#
# It must leave stdout untouched: stdout is the ACP JSON-RPC wire, so
# diagnostics from this script or the harness go to stderr.
#
# The working directory is inherited from Zed and becomes the workspace root
# and sandbox root, so it is not overridden here. The profile itself is
# created under $DSH_HOME/profiles/acp on first boot.
set -eu

DSH_ROOT=/opt/helix/dsh

exec node \
  "${DSH_ROOT}/node_modules/@deepseek-ai/dsh/lib/bin.js" \
  --profile acp \
  --patch "${DSH_ROOT}/helix.patch.yml" \
  "$@"
