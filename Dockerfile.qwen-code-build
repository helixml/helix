# Produces a pinned Qwen Code runtime for the desktop images. Qwen publishes a
# self-contained npm package, so Helix no longer needs a source checkout or a
# fork-specific build. QWEN_VERSION comes from sandbox-versions.txt; upgrading
# Qwen is a one-line pin change followed by a live ACP turn.
FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS builder

ARG QWEN_VERSION
RUN <<_INSTALL_QWEN
set -eu
test -n "${QWEN_VERSION}"
npm install --global --prefix /opt/qwen-code \
  --no-audit --no-fund "@qwen-code/qwen-code@${QWEN_VERSION}"
/opt/qwen-code/bin/qwen --version | grep -Fx "${QWEN_VERSION}"
echo "${QWEN_VERSION}" > /opt/qwen-code/version
npm cache clean --force > /dev/null 2>&1 || true
_INSTALL_QWEN

FROM scratch
COPY --from=builder /opt/qwen-code/ /
