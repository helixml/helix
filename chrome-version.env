# Chromium in the crawler browser image (Dockerfile.chrome).
#
# The image installs Debian trixie's chromium-headless-shell, which Debian
# security keeps on the current stable major. These values are the floor the
# image build asserts and the reference scripts/check-chromium-freshness.sh
# falls back to when it cannot reach the Chrome release feed. Raise both
# when you rebuild against a newer Chromium.
CHROMIUM_MIN_MAJOR=156
CHROMIUM_RECORDED_AT=2026-11-13
