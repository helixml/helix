# Pins for the crawler browser image (Dockerfile.chrome).
#
# Chromium comes from Debian trixie-security, read through snapshot.debian.org
# so a build is reproducible. To move to a newer Chromium, bump together:
#   - DEBIAN_SNAPSHOT: a recent https://snapshot.debian.org timestamp
#   - CHROMIUM_VERSION: `apt-cache policy chromium-headless-shell` in
#     debian:trixie-slim at that time
#   - CHROMIUM_STABLE_MAJOR / CHROMIUM_STABLE_AT: Chrome's stable major today
#   - the golang and debian base image digests in Dockerfile.chrome
# scripts/check-chromium-freshness.sh (CI) says when a bump is due.
DEBIAN_SNAPSHOT=20261113T000000Z
CHROMIUM_VERSION=156.0.8078.79-1~deb13u1
CHROMIUM_STABLE_MAJOR=157
CHROMIUM_STABLE_AT=2026-11-13
# Majors the image may trail Chrome stable by.
CHROMIUM_MAX_LAG=2
